      "documented_intro": "The method allows you to add a manual credit settlement (repayment) for a chosen contractor in Base Connect. A settlement reduces the blocked credit amount for the contractor, effectively recording a payment received for previously charged orders. The settlement amount cannot exceed the contractor's currently blocked credit amount (credit_to_pay).",
      "input_table": [
        {
          "row": 1,
          "name": "connect_contractor_id",
          "documented_type": "int",
          "description": "Contractor ID. The list of contractor identifiers can be retrieved using the getConnectIntegrationContractors method",
          "required": null,
          "requiredness": "NOT_NORMALIZED_HERE; consult the pinned contract section and source prose"
        },
        {
          "row": 2,
          "name": "amount",
          "documented_type": "float",
          "description": "Settlement amount. Must be a positive value and cannot exceed the contractor's currently blocked credit amount (credit_to_pay). Can be passed as string or number in JSON",
          "required": null,
          "requiredness": "NOT_NORMALIZED_HERE; consult the pinned contract section and source prose"
        },
        {
          "row": 3,
          "name": "message",
          "documented_type": "varchar(255)",
          "description": "Settlement note/comment describing the repayment, e.g., payment reference, bank transfer ID, etc. Maximum 255 characters",
          "required": null,
          "requiredness": "NOT_NORMALIZED_HERE; consult the pinned contract section and source prose"
        },
        {
          "row": 4,
          "name": "order_id",
          "documented_type": "int",
          "description": "Related order ID if the settlement is connected to a specific order. Use 0 or omit if not related to any specific order",
          "required": null,
          "requiredness": "NOT_NORMALIZED_HERE; consult the pinned contract section and source prose"
        }
      ],
      "output_table": [
        {
          "row": 1,
