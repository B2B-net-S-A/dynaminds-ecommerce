    "kind": "append_domain_row_only",
    "target_collection": "domains.rows",
    "append_rows": [
      {
        "id": "DOM-CRM-004",
        "domain": "CRM",
        "requirement": "Definicje dodatkowych pól CRM oraz jawny odczyt i zapis wartości klienta, z odrębnym transportem plików i usuwaniem wartości",
        "operations": [
          "odczyt definicji extra_field_id/name/editor_type/options",
          "prezentacja i rozróżnienie typów text,number,select,checkbox,radio,date,file",
          "jawny odczyt wartości konkretnego klienta przez getCrmClientData(include_custom_extra_fields=true), defaultfalse",
          "zapis wartości według istniejącego extra_field_id przez addCrmClient(custom_extra_fields), usunięcie wartości pustym tekstem",
          "plik: zapis title i data:<base64>, odczyt title/url zamiast zwracania uploadbase64"
        ],
        "base_sources": [
          {
            "method": "addCrmClient",
            "url": "https://api.baselinker.com/index.php?method=addCrmClient",
            "observed_at": "2026-10-17T17:57:12.092696+00:00",
