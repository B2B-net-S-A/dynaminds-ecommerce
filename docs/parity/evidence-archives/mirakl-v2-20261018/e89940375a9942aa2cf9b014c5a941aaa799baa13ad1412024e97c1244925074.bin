  app.post('/api/inventory/adjust/previews', { onRequest: async () => ensure(!readOnly,423,'Kopia jest tylko do odczytu'), bodyLimit:2*1024*1024 }, async (req,reply) => {
    ensure(wmsLotsAvailable,503,'Kopia nie zawiera WMS partii');
